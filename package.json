{
  "name": "trauma",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "HOST=${HOST:-127.0.0.1} bun --bun x vinxi dev",
    "dev:smoke": "bun run scripts/dev-smoke.ts",
    "build": "vinxi build",
    "start": "HOST=${HOST:-127.0.0.1} bun --bun x vinxi start",
    "preview": "HOST=${HOST:-127.0.0.1} bun --bun x vinxi preview",
    "audit": "bun audit --ignore GHSA-67mh-4wv8-2f99 --ignore GHSA-g7r4-m6w7-qqqr",
    "docs:check": "bun run scripts/check-docs.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun x vitest run",
    "test:watch": "bun --bun x vitest",
    "test:e2e": "playwright test",
    "test:e2e:preflight": "bun run scripts/check-playwright-browser.ts",
    "build:extension": "bun run scripts/build-browser-extension.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate-database.ts",
    "verify": "bun run docs:check && bun run typecheck && bun run test && TRAUMA_BUILD_OUTPUT_DIR=${TRAUMA_BUILD_OUTPUT_DIR:-.output-verify} vinxi build",
    "verify:full": "bun run verify && bun run test:e2e:preflight && bun run test:e2e"
  },
  "dependencies": {
    "@corvu/drawer": "^0.2.4",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-sans-tc": "^5.3.1",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@fontsource/biz-udpgothic": "^5.3.0",
    "@fontsource/biz-udpmincho": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/ibm-plex-sans-jp": "^5.3.1",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@kobalte/core": "^0.13.14",
    "@solidjs/meta": "^0.29.8",
    "@solidjs/router": "^0.15.4",
    "@solidjs/start": "1.3.2",
    "defuddle": "^0.19.13",
    "drizzle-orm": "^0.45.4",
    "entities": "^7.0.1",
    "highlight.js": "^11.12.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.15",
    "markdown-it": "^14.3.3",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-footnote": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sanitize-html": "^2.18.2",
    "solid-js": "^1.9.20",
    "unified": "^11.0.5",
    "unist-util-visit-parents": "^6.1.0",
    "vinxi": "^0.5.11"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@babel/core": "7.29.7",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/markdown-it": "14.1.2",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/sanitize-html": "^2.16.2",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@xmldom/xmldom": "0.9.12",
    "brace-expansion": "5.1.0",
    "follow-redirects": "1.16.3",
    "glob": "14.0.6",
    "h3": "1.15.11",
    "katex": "0.19.1",
    "minimatch": "11.0.9",
    "nanoid": "3.3.20",
    "node-forge": "1.4.4",
    "playwright-core": "1.65.1",
    "postcss": "8.5.23",
    "postcss-selector-parser": "6.1.6",
    "serialize-javascript": "7.1.4",
    "seroval": "1.8.2",
    "source-map-js": "1.2.4",
    "tar": "7.5.21",
    "vite": "6.4.6",
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.3.13"
}
